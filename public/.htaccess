<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS on HostAfrica
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?agriscanai\.co\.ke$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Direct API endpoints to PHP handlers on HostAfrica cPanel
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]
  RewriteRule ^api/download/?$ api/download.php [L,QSA]

  # Direct APK download redirects/aliases to AgriScanAI.apk
  RewriteRule ^downloads/app-release\.apk$ /downloads/AgriScanAI.apk [NC,L]
  RewriteRule ^downloads/agriscanai\.apk$ /downloads/AgriScanAI.apk [NC,L]

  # Don't rewrite existing files or directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # React Single Page App fallback routing
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# Prevent directory listings
Options -Indexes

# Cache-Control headers for performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
